-- ---------------------------------------------------------------------------
-- R6 拆分产物（2026-09-28）：本机 PDMS 12.1 SP4 实测，.pmlfnc 只按「文件名 = 函数名」
--   （忽略大小写）被 PMLLIB 自动加载；多函数单文件里的其余函数不可解析
--   （R4 实机 F4: !!pkpm2pdmsRenamesCount -> "PML: Function not found"；
--    P7_export_1: "(46,85) PML: Wrong Function found"）。故一函数一文件。
-- 源     : pkpm2pdmsexport.pmlfnc（R6 拆分前单体；函数体原样切出，未改一行代码）
-- 函数   : !!pkpm2pdmsori
-- ---------------------------------------------------------------------------
-- ---------------------------------------------------------------------------
-- ori 冗余自校验位（契约 §c.3.6）：U / E / N / S
-- ---------------------------------------------------------------------------
define function !!pkpm2pdmsori(!dE is REAL, !dN is REAL, !dU is REAL) is STRING

   !aE = !dE
   if (!aE lt 0.0) then
      !aE = - !aE
   endif
   !aN = !dN
   if (!aN lt 0.0) then
      !aN = - !aN
   endif
   !aU = !dU
   if (!aU lt 0.0) then
      !aU = - !aU
   endif

   if (!aU gt 1.0) then
      if (!aE le 1.0 and !aN le 1.0) then
         return 'U'
      endif
      return 'S'
   endif
   if (!aN le 1.0 and !aE gt 1.0) then
      return 'E'
   endif
   if (!aE le 1.0 and !aN gt 1.0) then
      return 'N'
   endif
   return 'S'

endfunction
-- End of function !!pkpm2pdmsori
