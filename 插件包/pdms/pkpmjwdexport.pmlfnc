------------------------------------------------------------------------------
-- PKPM-JWD导入导出 —— PDMS 侧导出函数（对应 CONTRACT v1.0 §c / §d.5）
-- 文件   : pkpmjwdexport.pmlfnc     落盘: GBK 无 BOM + CRLF，注释一律用 --
-- 入口   : !!pkpmjwdexport(!scope is DBREF, !outFile is STRING) is STRING
--          由 pkpmjwd.pmlfrm 的「导出当前模型到文本」按钮调用；
--          命令行也可直接执行（见 README 用法）。
-- 职责   : 遍历 SITE → ZONE → STRU → FRMW → SBFR → SCTN/PANE/STWALL，
--          写 #PKPM-JWD-PDMSDUMP 1.0 中性交换文本（契约 §c.2 文法）。
-- 返回值 : 'OK|site=..|zone=..|stru=..|frmw=..|sbfr=..|sctn=..|pane=..|stwall=..|
--           skip=..|unit=..|lines=..'  或  'ERR|<原因>'
--
-- 语法出处（全部为本机 D:\AVEVA\Plant\PDMS12.1.SP4\PMLLIB 内既有代码，未自造语法）：
--   define function / is STRING / handle any / endhandle
--        common\functions\comunitsconvert.pmlfnc:30,51-56
--   .mCount() / .members[i] / .type eq |TOKEN|      common\functions\findfirstmember.pmlfnc:37,43,46-49
--   |STRU| |FRMW| |SBFR| 类型码 / .owner.type      common\forms\saverestoreview.pmlfrm:310,317
--   |SCTN| |PANE| |STWALL| |WALL| |PLOO| |PLOOP|   design\functions\sctlcrelem.pmlfnc:156,201,229
--                                                  design\functions\cvfloortracefl.pmlfnc:42
--   !!findFirstMember(元素,'PLOO','',消息)          design\functions\cvfloortracefl.pmlfnc:42
--   object COMUNITS(TRUE) / getDimensionIndex / savedUnits
--                                                  aba\Forms\ababuildkeyplan.pmlfrm:224-227
--   !!comUnitsConvert(值,'DIST','MM')              common\functions\comunitsconvert.pmlfnc:30
--   object FILE / .open / .writeFile('OVERWRITE',!数组) / .close / .exists
--                                                  design\objects\hvacDetailSpec.pmlobj:95-96,515-516
--                                                  common\forms\runmacro.pmlfrm:55-57,82
--   属性 .poss/.pose/.east/.north/.up              aba\UserTasks\aaagrids.pmlfnc:162
--                                                  accommodation\...\accceilinggriddefinition.pmlfrm:1396-1397
--   PLOOP 厚度 .heig                               common\functions\lineonextrusion.pmlfnc:53
--   规格 .spref/.spre、.jusl/.meml、.bang、.desp[i] sctlcrelem.pmlfnc:201-202,229-292
--                                                  Building_Design\...\nucdesothickval.pmlobj:273
--                                                  MYTOOLS\...\sdnfinver3.pmlfnc:117-198
--   全名 .flnn                                     aba\Forms\abaareabyvol.pmlfrm:324
--   字符串 .replace/.upcase/.after/.length         aba\Forms\ababatchmode.pmlfrm:375
--                                                  common\functions\comunitsconvert.pmlfnc:33
--                                                  common\functions\findfirstmember.pmlfnc:41
--
-- 写方纪律（与契约逐条对应）：
--   1) 长度量按数据库当前 DIST 单位写出，并在第 2 行写 UNITS 声明；数据库单位不是
--      mm/cm/m 时，用 !!comUnitsConvert(...,'DIST','MM') 换算后写 UNITS mm（§c.1）。
--   2) 坐标取 POSS/POSE 的 .East/.North/.Up 分量（§c.5）；本包生成的
--      SITE/ZONE/STRU/FRMW/SBFR 都在原点且无旋转，故等价于模型绝对坐标。
--   3) 名称中的空白与 '~' 一律替换为 '_'（§c.1：名称不含空白、不含 '~'）。
--   4) 角度 BANG 恒为度、不随单位变化（§c.1）；'~' 尾部厚度取不到时整段省略（§c.5）。
--   5) 行分隔符由 PDMS 文件对象按本机惯例写出；契约 §c.1 要求 CRLF，读方
--      engine/pdms_dump.py 按 splitlines() 处理（LF/CRLF 均可解析）。
--   6) 几何容差 TOL=1.0（数据库长度单位）用于 ctype/ori 判定，与读方 §c.3.6 同义。
------------------------------------------------------------------------------


-- ---------------------------------------------------------------------------
-- 名称清洗：空白与 '~' → '_'（契约 §c.1）
-- ---------------------------------------------------------------------------
define function !!pkpmjwdname(!value is STRING) is STRING

   if (!value.unset()) then
      return ''
   endif
   !s = !value.replace(' ', '_')
   !s = !s.replace('~', '_')
   return !s

endfunction
-- End of function !!pkpmjwdname


-- ---------------------------------------------------------------------------
-- 数值转文本：!toMm 为真时先由数据库单位换算成 mm（契约 §c.1）
-- ---------------------------------------------------------------------------
define function !!pkpmjwdnum(!value is REAL, !toMm is BOOLEAN) is STRING

   if (!toMm) then
      return !value.string()
   endif
   return !!comUnitsConvert(!value, 'DIST', 'MM').string()

endfunction
-- End of function !!pkpmjwdnum


-- ---------------------------------------------------------------------------
-- DESP 参数串：返回 ' v1 v2 …'（无参数返回空串）。
-- 上界 13 与 MYTOOLS\...\sdnfinver3.pmlfnc:117-198 的 despar[1..13] 一致。
-- ---------------------------------------------------------------------------
define function !!pkpmjwddesp(!element is DBREF, !toMm is BOOLEAN) is STRING

   !out = ''
   do !i from 1 to 13
      handle any
         !v = !element.desp[!i]
         if (!v.unset().not()) then
            !out = !out & ' ' & !!pkpmjwdnum(!v, !toMm)
         endif
      endhandle
   enddo
   return !out

endfunction
-- End of function !!pkpmjwddesp


-- ---------------------------------------------------------------------------
-- 组名匹配：'COLUMN' 与 '/COLUMN'（含 '/EL1/COLUMN'）都算命中（契约 §12#1 的命名歧义）
-- ---------------------------------------------------------------------------
define function !!pkpmjwdgroup(!value is STRING, !token is STRING) is BOOLEAN

   if (!value.unset()) then
      return FALSE
   endif
   !v = !value.upcase()
   !t = !token.upcase()
   if (!v eq !t) then
      return TRUE
   endif
   if (!v.after('/') eq !t) then
      return TRUE
   endif
   return FALSE

endfunction
-- End of function !!pkpmjwdgroup


-- ---------------------------------------------------------------------------
-- ctype：优先用所属 SBFR 名（COLUMN/BEAM/HBRACE/VBRACE），否则按几何判定（契约 §c.5）
-- ---------------------------------------------------------------------------
define function !!pkpmjwdctype(!sbname is STRING, !dE is REAL, !dN is REAL, !dU is REAL) is STRING

   if (!!pkpmjwdgroup(!sbname, 'COLUMN')) then
      return 'COLUMN'
   endif
   if (!!pkpmjwdgroup(!sbname, 'BEAM')) then
      return 'BEAM'
   endif
   if (!!pkpmjwdgroup(!sbname, 'HBRACE')) then
      return 'HBRACE'
   endif
   if (!!pkpmjwdgroup(!sbname, 'VBRACE')) then
      return 'VBRACE'
   endif

   -- 几何兜底：竖向 → COLUMN；水平 → BEAM；其余斜置 → VBRACE
   !aE = !dE
   if (!aE lt 0.0) then
      !aE = - !aE
   endif
   !aN = !dN
   if (!aN lt 0.0) then
      !aN = - !aN
   endif
   !aU = !dU
   if (!aU lt 0.0) then
      !aU = - !aU
   endif
   if (!aU gt 1.0) then
      if (!aE le 1.0 and !aN le 1.0) then
         return 'COLUMN'
      endif
      return 'VBRACE'
   endif
   return 'BEAM'

endfunction
-- End of function !!pkpmjwdctype


-- ---------------------------------------------------------------------------
-- ori 冗余自校验位（契约 §c.3.6）：U / E / N / S
-- ---------------------------------------------------------------------------
define function !!pkpmjwdori(!dE is REAL, !dN is REAL, !dU is REAL) is STRING

   !aE = !dE
   if (!aE lt 0.0) then
      !aE = - !aE
   endif
   !aN = !dN
   if (!aN lt 0.0) then
      !aN = - !aN
   endif
   !aU = !dU
   if (!aU lt 0.0) then
      !aU = - !aU
   endif

   if (!aU gt 1.0) then
      if (!aE le 1.0 and !aN le 1.0) then
         return 'U'
      endif
      return 'S'
   endif
   if (!aN le 1.0 and !aE gt 1.0) then
      return 'E'
   endif
   if (!aE le 1.0 and !aN gt 1.0) then
      return 'N'
   endif
   return 'S'

endfunction
-- End of function !!pkpmjwdori


-- ---------------------------------------------------------------------------
-- #SBFR 组名（仅用于 FRMW 直挂构件的情形，本包生成的树走 !sb.name）
-- ---------------------------------------------------------------------------
define function !!pkpmjwdgroupof(!el is DBREF) is STRING

   if (!el.type eq |PANE|) then
      return '/SLAB'
   endif
   if (!el.type eq |STWALL|) then
      return '/WALL'
   endif
   !p1 = !el.poss
   !p2 = !el.pose
   return '/' & !!pkpmjwdctype('', !p2.east - !p1.east, !p2.north - !p1.north, !p2.up - !p1.up)

endfunction
-- End of function !!pkpmjwdgroupof


-- ---------------------------------------------------------------------------
-- #SCTN 记录（契约 §c.2 / §c.5）
-- ---------------------------------------------------------------------------
define function !!pkpmjwdsctn(!el is DBREF, !sbname is STRING, !toMm is BOOLEAN) is STRING

   !p1 = !el.poss
   !p2 = !el.pose
   !dE = !p2.east - !p1.east
   !dN = !p2.north - !p1.north
   !dU = !p2.up - !p1.up

   !spec = '-'
   handle any
      if (!el.spref.unset().not() and !el.spref.badref().not()) then
         !spec = !el.spref.flnn
      endif
   endhandle

   !jusl = '-'
   handle any
      if (!el.jusl.unset().not()) then
         !jusl = !el.jusl
      endif
   endhandle

   !meml = '-'
   handle any
      if (!el.meml.unset().not()) then
         !meml = !el.meml
      endif
   endhandle

   !bang = 0.0
   handle any
      !bang = !el.bang
   endhandle

   !rec = '#SCTN ' & !!pkpmjwdname(!el.name)
   !rec = !rec & ' ' & !!pkpmjwdctype(!sbname, !dE, !dN, !dU)
   !rec = !rec & ' ' & !spec
   !rec = !rec & !!pkpmjwddesp(!el, !toMm)
   !rec = !rec & ' ' & !!pkpmjwdnum(!p1.east, !toMm) & ' ' & !!pkpmjwdnum(!p1.north, !toMm) & ' ' & !!pkpmjwdnum(!p1.up, !toMm)
   !rec = !rec & ' ' & !!pkpmjwdnum(!p2.east, !toMm) & ' ' & !!pkpmjwdnum(!p2.north, !toMm) & ' ' & !!pkpmjwdnum(!p2.up, !toMm)
   !rec = !rec & ' ' & !!pkpmjwdori(!dE, !dN, !dU)
   !rec = !rec & ' ' & !jusl & ' ' & !meml & ' ' & !!pkpmjwdnum(!bang, FALSE)
   return !rec

endfunction
-- End of function !!pkpmjwdsctn


-- ---------------------------------------------------------------------------
-- #PANE 记录（契约 §c.2 / §c.5）；顶点不足 3 个时返回空串，由调用方计入 skip
-- ---------------------------------------------------------------------------
define function !!pkpmjwdpane(!el is DBREF, !toMm is BOOLEAN) is STRING

   !msg = ''
   !loop = !!findFirstMember(!el, 'PLOO', '', !msg)
   if (!loop.unset()) then
      return ''
   endif
   if (!loop.badref()) then
      return ''
   endif

   !thk = 0.0
   handle any
      !thk = !loop.heig
   endhandle

   !rec = '#PANE ' & !!pkpmjwdname(!el.name) & ' ' & !!pkpmjwdnum(!thk, !toMm)
   !nv = 0
   do !i from 1 to !loop.mCount()
      !v = !loop.members[!i]
      !pv = !v.pos
      !rec = !rec & ' ' & !!pkpmjwdnum(!pv.east, !toMm) & ' ' & !!pkpmjwdnum(!pv.north, !toMm) & ' ' & !!pkpmjwdnum(!pv.up, !toMm)
      !nv = !nv + 1
   enddo
   if (!nv lt 3) then
      return ''
   endif

   !spec = ''
   handle any
      if (!el.spref.unset().not() and !el.spref.badref().not()) then
         !spec = !el.spref.flnn
      endif
   endhandle

   !sjus = 'dbot'
   handle any
      if (!el.sjus.unset().not()) then
         !sjus = !el.sjus
      endif
   endhandle

   if (!spec.length() gt 0) then
      !rec = !rec & ' ~ ' & !spec & ' YNZU ' & !sjus
   endif
   return !rec

endfunction
-- End of function !!pkpmjwdpane


-- ---------------------------------------------------------------------------
-- #STWALL 记录（契约 §c.2 / §c.5）；厚度尾部取不到时整段省略
-- ---------------------------------------------------------------------------
define function !!pkpmjwdstwall(!el is DBREF, !toMm is BOOLEAN) is STRING

   !p1 = !el.poss
   !p2 = !el.pose

   !h = 0.0
   handle any
      !h = !el.heig
   endhandle

   !spre = '-'
   handle any
      if (!el.spre.unset().not() and !el.spre.badref().not()) then
         !spre = !el.spre.flnn
      endif
   endhandle
   if (!spre eq '-') then
      -- 兜底：若该墙把规格挂在 SPREF 上（契约 §12#2 的反例写法），也照实导出
      handle any
         if (!el.spref.unset().not() and !el.spref.badref().not()) then
            !spre = !el.spref.flnn
         endif
      endhandle
   endif

   !rec = '#STWALL ' & !!pkpmjwdname(!el.name) & ' ' & !spre & ' ' & !!pkpmjwdnum(!h, !toMm)
   !rec = !rec & ' ' & !!pkpmjwdnum(!p1.east, !toMm) & ' ' & !!pkpmjwdnum(!p1.north, !toMm) & ' ' & !!pkpmjwdnum(!p1.up, !toMm)
   !rec = !rec & ' ' & !!pkpmjwdnum(!p2.east, !toMm) & ' ' & !!pkpmjwdnum(!p2.north, !toMm) & ' ' & !!pkpmjwdnum(!p2.up, !toMm)

   handle any
      !t = !el.desp[1]
      if (!t.unset().not()) then
         !rec = !rec & ' ~ ' & !!pkpmjwdnum(!t, !toMm)
      endif
   endhandle
   return !rec

endfunction
-- End of function !!pkpmjwdstwall


-- ---------------------------------------------------------------------------
-- 主函数：!!pkpmjwdexport(!scope, !outFile)
-- ---------------------------------------------------------------------------
define function !!pkpmjwdexport(!scope is DBREF, !outFile is STRING) is STRING

   -- 0) 参数检查
   if (!outFile.unset() or !outFile.length() le 0) then
      return 'ERR|导出文件路径为空'
   endif
   if (!scope.unset()) then
      return 'ERR|导出范围无效（未指定导出范围元素）'
   endif
   if (!scope.badref()) then
      return 'ERR|导出范围无效（DBREF 无效）'
   endif

   -- 1) 向上找到所属 SITE（最多 20 级）
   !site = !scope
   !found = FALSE
   do !i from 1 to 20
      if (!found.not()) then
         handle any
            if (!site.type eq |SITE|) then
               !found = TRUE
            else
               !site = !site.owner
            endif
         endhandle
      endif
   enddo
   if (!found.not()) then
      return 'ERR|未能在 20 级内找到所属 SITE'
   endif

   -- 2) 单位：数据库当前 DIST 单位；不是 mm/cm/m 时换算成 mm 并写 UNITS mm（§c.1）
   !units = object COMUNITS(TRUE)
   !distIndex = !units.getDimensionIndex('DIST')
   !unitName = !units.savedUnits[!distIndex].lowcase()
   !wUnit = !unitName
   !toMm = FALSE
   if (!unitName eq 'mm' or !unitName eq 'cm' or !unitName eq 'm') then
      !toMm = FALSE
      !wUnit = !unitName
   else
      !toMm = TRUE
      !wUnit = 'mm'
   endif

   -- 3) 逐级遍历，收集记录行
   !lines = object ARRAY()
   !n = 0
   !nZ = 0
   !nS = 0
   !nF = 0
   !nB = 0
   !nC = 0
   !nP = 0
   !nW = 0
   !nSkip = 0

   !n = !n + 1
   !lines[!n] = '#PKPM-JWD-PDMSDUMP 1.0'
   !n = !n + 1
   !lines[!n] = 'UNITS ' & !wUnit
   !n = !n + 1
   !lines[!n] = '#SITE ' & !!pkpmjwdname(!site.name)

   do !i1 from 1 to !site.mCount()
      !e1 = !site.members[!i1]
      if (!e1.type eq |ZONE|) then
         !nZ = !nZ + 1
         !n = !n + 1
         !lines[!n] = '#ZONE ' & !!pkpmjwdname(!e1.name)

         do !i2 from 1 to !e1.mCount()
            !e2 = !e1.members[!i2]
            if (!e2.type eq |STRU|) then
               !nS = !nS + 1
               !n = !n + 1
               !lines[!n] = '#STRU ' & !!pkpmjwdname(!e2.name)

               do !i3 from 1 to !e2.mCount()
                  !e3 = !e2.members[!i3]
                  if (!e3.type eq |FRMW|) then
                     !nF = !nF + 1
                     !n = !n + 1
                     !lines[!n] = '#FRMW ' & !!pkpmjwdname(!e3.name)

                     do !i4 from 1 to !e3.mCount()
                        !e4 = !e3.members[!i4]
                        if (!e4.type eq |SBFR|) then
                           !nB = !nB + 1
                           !n = !n + 1
                           !lines[!n] = '#SBFR ' & !!pkpmjwdname(!e4.name)

                           do !i5 from 1 to !e4.mCount()
                              !e5 = !e4.members[!i5]
                              !t5 = !e5.type
                              if (!t5 eq |SCTN|) then
                                 !nC = !nC + 1
                                 !n = !n + 1
                                 !lines[!n] = !!pkpmjwdsctn(!e5, !e4.name, !toMm)
                              elseif (!t5 eq |PANE|) then
                                 !rec = !!pkpmjwdpane(!e5, !toMm)
                                 if (!rec.length() gt 0) then
                                    !nP = !nP + 1
                                    !n = !n + 1
                                    !lines[!n] = !rec
                                 else
                                    !nSkip = !nSkip + 1
                                 endif
                              elseif (!t5 eq |STWALL|) then
                                 !nW = !nW + 1
                                 !n = !n + 1
                                 !lines[!n] = !!pkpmjwdstwall(!e5, !toMm)
                              endif
                           enddo
                        elseif (!e4.type eq |SCTN| or !e4.type eq |PANE| or !e4.type eq |STWALL|) then
                           -- FRMW 直挂构件（非本包生成的树）：补一条 #SBFR 组行
                           !g = !!pkpmjwdgroupof(!e4)
                           !n = !n + 1
                           !lines[!n] = '#SBFR ' & !g
                           if (!e4.type eq |SCTN|) then
                              !nC = !nC + 1
                              !n = !n + 1
                              !lines[!n] = !!pkpmjwdsctn(!e4, !g, !toMm)
                           elseif (!e4.type eq |PANE|) then
                              !rec = !!pkpmjwdpane(!e4, !toMm)
                              if (!rec.length() gt 0) then
                                 !nP = !nP + 1
                                 !n = !n + 1
                                 !lines[!n] = !rec
                              else
                                 !nSkip = !nSkip + 1
                              endif
                           else
                              !nW = !nW + 1
                              !n = !n + 1
                              !lines[!n] = !!pkpmjwdstwall(!e4, !toMm)
                           endif
                        endif
                     enddo
                  endif
               enddo
            endif
         enddo
      endif
   enddo

   !n = !n + 1
   !lines[!n] = '#END'

   -- 4) 写出（覆盖写；不改任何既有文件）
   !ok = FALSE
   handle any
      !file = object FILE(!outFile)
      !file.open('OVERWRITE')
      !file.writeFile('OVERWRITE', !lines)
      !file.close()
      !file = object FILE(!outFile)
      if (!file.exists()) then
         !ok = TRUE
      endif
   endhandle
   if (!ok.not()) then
      return 'ERR|写入 ' & !outFile & ' 失败（请检查路径与目录是否存在）'
   endif

   !res = 'OK|site=1|zone=' & !nZ.string()
   !res = !res & '|stru=' & !nS.string() & '|frmw=' & !nF.string()
   !res = !res & '|sbfr=' & !nB.string() & '|sctn=' & !nC.string() & '|pane=' & !nP.string()
   !res = !res & '|stwall=' & !nW.string() & '|skip=' & !nSkip.string()
   !res = !res & '|unit=' & !wUnit & '|lines=' & !n.string()
   return !res

endfunction
-- End of function !!pkpmjwdexport


-- ---------------------------------------------------------------------------
-- 便捷入口：!!pkpmjwdexportce(!outFile) —— 以当前元素 !!CE 为范围
-- ---------------------------------------------------------------------------
define function !!pkpmjwdexportce(!outFile is STRING) is STRING

   return !!pkpmjwdexport(!!ce, !outFile)

endfunction
-- End of function !!pkpmjwdexportce

-- End of file pkpmjwdexport.pmlfnc
