-- ---------------------------------------------------------------------------
-- R6 拆分产物（2026-09-28）：本机 PDMS 12.1 SP4 实测，.pmlfnc 只按「文件名 = 函数名」
--   （忽略大小写）被 PMLLIB 自动加载；多函数单文件里的其余函数不可解析
--   （R4 实机 F4: !!pkpm2pdmsRenamesCount -> "PML: Function not found"；
--    P7_export_1: "(46,85) PML: Wrong Function found"）。故一函数一文件。
-- 源     : pkpm2pdmsexport.pmlfnc（R6 拆分前单体；函数体原样切出，未改一行代码）
-- 函数   : !!pkpm2pdmsgroup
-- ---------------------------------------------------------------------------
-- ---------------------------------------------------------------------------
-- 组名匹配：'COLUMN' 与 '/COLUMN'（含 '/EL1/COLUMN'）都算命中（契约 §12#1 的命名歧义）
-- ---------------------------------------------------------------------------
define function !!pkpm2pdmsgroup(!value is STRING, !token is STRING) is BOOLEAN

   if (!value.unset()) then
      return FALSE
   endif
   !v = !value.upcase()
   !t = !token.upcase()
   if (!v eq !t) then
      return TRUE
   endif
   if (!v.after('/') eq !t) then
      return TRUE
   endif
   return FALSE

endfunction
-- End of function !!pkpm2pdmsgroup
