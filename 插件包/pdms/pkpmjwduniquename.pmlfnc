------------------------------------------------------------------------------
-- PKPM-JWD导入导出 —— 命名唯一化（重名加 re / re2 / re3 …）
-- 文件   : pkpmjwduniquename.pmlfnc     落盘: GBK 无 BOM + CRLF，注释一律用 --
-- 契约   : CONTRACT v3 §o（§o.1 候选序列 / §o.2 签名 / §o.3 探测写法① /
--          §o.4 宏模板 / §o.6 失败行为 / §o.7 可追溯；附录 F.1 是逐字夹具）
-- 预载   : $M "%PMLLIB%/pkpmjwd/pkpmjwduniquename.pmlfnc"
--          （$M 加载 %PMLLIB% 下的 .pmlfnc：admin\forms\adminapplic.pmlfrm:205
--           $M "%PMLLIB%/limbo/functions/moduleswitch.pmlfnc"；
--           函数内 $M 的实例：common\functions\comaddcurclaim.pmlfnc:75；
--           入口宏 pkpmjwdrun.mac 与 macgen 生成的导入宏各自预载一次）
--
-- 入口（本文件定义 4 个函数）：
--   !!pkpmjwdUniquename(!base is STRING) is STRING   主函数（契约冻结签名）
--   !!pkpmjwdRenamesCount() is REAL                  记录条数（窗体显示用）
--   !!pkpmjwdRenamesFailCount() is REAL              FAIL 条数（窗体显示用）
--   !!pkpmjwdRenamesShow()                           逐条 $P 打印（窗体「改名清单」用）
--
-- 算法（§o.1 冻结）：候选 = base, base&'re', base&'re2' … base&'re99'（do 0..99，共 100 个）；
--   取第一个未被占用的；全部占用 => 记 'FAIL|<base>|<base>re99' 并返回 ''（§o.6，
--   由导入宏的 ONERROR GOLABEL /PKPMJWDERR 中止，绝不跳过）。
--   改名记录格式（§o.2/§o.7 冻结）：'TYPE|原名|实际名'，TYPE 来自 !!pkpmjwdType（见下）；
--   原名本身可用时不留痕（report.renames 为空数组 = 全部原名可用）。
--
-- == 探测写法（§o.3 写法①：VAR EXIST + handle (2,109)，两种已证实结局都处理）==
--   本机 PMLLIB 里 `VAR !x EXIST <名>` 有两种并存且不矛盾的用法：
--   (a) 结果值判定：存在 => 'TRUEA'，不存在 => 'FALSEA'，VAR 本身不报错——
--       assembly\functions\assybuildname.pmlfnc:47-50,64-65（VAR EXIST 后直接
--       if (!exists.eq('FALSEA'))，无 handle —— 名字不存在时 VAR 正常返回）；
--       aba\Forms\abaarealib.pmlfrm:304-306（if (!exists.eq('TRUEA')) => 报
--       'An element of this name already exists'）；aba\Forms\abauserview.pmlfrm:859-860；
--       TIANGONG\functions\tgautonum.pmlfnc:34-41（函数内 do 循环逐个探测，同款）。
--   (b) 错误捕获：VAR 包在 handle (2,109) 里，落到 (2,109) = Undefined name——
--       aba\Forms\abaarealib.pmlfrm:107-114（注释原文 -- Undefined name）。
--       （该处 (2,109) 实际覆盖的是「$!… 插值目标本身未定义/畸形」的情形。）
--   => 本函数两种都写：handle (2,109) 命中 => 视为可用（契约 §o.3 冻结语义）；
--     VAR 正常返回时按 (a) 的值判定（'TRUEA' => 占用，否则可用）。
--     若只按夹具的「无 (2,109) 即占用」，全新库里每个空間名都会被误判为占用
--     （VAR EXIST 对空間名正常返回 'FALSEA' 而不是报错，见 (a) 的四处直证），
--     函数将永远 FAIL —— 这正是附录 F.1 末尾「夹具表达算法，落地要能跑」的情形，
--     差异在此如实说明；冻结要素（候选序列 / EXIST+(2,109) / 记录格式 / FAIL 语义）不变。
--
-- == TYPE 通道（与 F.1 的一处必要偏差，如实说明）==
--   F.1/§o.4 原文写 `!pkpmjwdType = 'SCTN'`（单 !）。PML 里单 ! 变量只在定义它的
--   宏/函数作用域内可见，跨作用域传递须用双 ! 全局（!!CE 等同理）。
--   本函数读取双 ! 全局 !!pkpmjwdType（undefined 时记 '?'）；调用方（宏/窗体）
--   两个名字都赋值，兼容两种作用域模型。R3 复核修正（§0.4-12）：生成器
--   （engine/macgen.py）此前误赋单 ! ， defined(!!pkpmjwdType) 恒假、改名记录
--   TYPE 恒 '?'；已改为赋双 ! 全局，与本函数一致。defined()/undefined() 的出处：
--   Building_Design\...\TRADUCTEUR\nucdesogwall.pmlobj:206 if(defined(!!CDPNRTN))；
--   TIANGONG\functions\tginjectdesignmenu.pmlfnc:16,33 if (undefined(!!appCntrl))。
--
-- 其余逐条出处（全部为本机 PMLLIB 内既有写法）：
--   define function … is STRING       assembly\functions\assybuildname.pmlfnc:32
--   object ARRAY()                    Building_Design\pmllib\room_manager\functions\nucroommcreation.pmlfnc:31
--   .append(…)                        mypml\forms\GRIDDESIGN.pmlfrm:986  !this.SCTNLIST.APPEND(!!CE)
--   do !i from 0 to 99 / 循环内探测   assembly\functions\assybuildname.pmlfnc:58-75（do+VAR EXIST+break）
--   break                             assybuildname.pmlfnc:71；tgautonum.pmlfnc:40；abauserview.pmlfrm:862
--   字符串拼接 &                      Building_Design\...\nucdesogwall.pmlobj:185（!Stwall 等拼接）
--   .string()（REAL→STRING）          mypml\forms\GRIDDESIGN.pmlfrm:975  !this.ZPOS[!EL].string()
--   .eq() / eq 运算符                 abaarealib.pmlfrm:305（.eq('TRUEA')）；MYTOOLS\...\sdnfinver3.pmlfnc:113（eq 运算符）
--   .upcase()                         common\functions\comunitsconvert.pmlfnc:33；ababuildprocess.pmlfnc:57
--   .length()                         common\functions\findfirstmember.pmlfnc:41（!type.length() le 0）
--   .unset()                          aba\Forms\ababatchmode.pmlfrm:671 等（本包 pkpmjwdexport.pmlfnc 同）
--   .size()（ARRAY）                  aba\Functions\ababuildeditform.pmlfnc:40；abamisslabel.pmlfnc:365
--   函数内 $P                         Building_Design\...\nucdesmexpandrooms.pmlfnc:34,46,53,61
--   函数内 .after()/.before()         aba\Forms\abaprocess.pmlfrm:845（本文件 show 用 .before('|')）
--
-- 逻辑等价自测：test/check_uniquify_logic.py（Python 复刻本函数逻辑；
--   含「库里已有 NAME、NAMEre => 返回 NAMEre2」场景。这是逻辑等价复刻，
--   **不是 PML 实机**——本包全程未启动 PDMS（§p.10 边界）。
------------------------------------------------------------------------------


-- ---------------------------------------------------------------------------
-- 主函数（契约 §o.2 冻结签名）
-- ---------------------------------------------------------------------------
define function !!pkpmjwdUniquename(!base is STRING) is STRING

   -- 0) 记录数组守卫（§o.2 步骤 1；defined()：nucdesogwall.pmlobj:206）
   if (defined(!!pkpmjwdRenames)) then
      -- 已存在：沿用（跨调用累计，窗体按差值显示"本次"）
   else
      !!pkpmjwdRenames = object ARRAY()
   endif

   -- 1) 空基名 = 编码错误，按失败处理（§o.2 步骤；F.1 夹具同款 'FAIL||'）
   if (!base.unset()) then
      !!pkpmjwdRenames.append('FAIL||')
      return ''
   endif
   if (!base.length() le 0) then
      !!pkpmjwdRenames.append('FAIL||')
      return ''
   endif

   -- TYPE 通道：双 ! 全局（见文件头说明）；未定义记 '?'
   !t = '?'
   if (defined(!!pkpmjwdType)) then
      !t = !!pkpmjwdType
   endif

   -- 2) 候选序列探测（§o.1：idx 0..99 共 100 个；§o.2 步骤 2）
   !final = ''
   do !idx from 0 to 99
      if (!idx eq 0) then
         !cand = !base
      elseif (!idx eq 1) then
         !cand = !base & 're'
      else
         !cand = !base & 're' & !idx.string()
      endif

      -- 探测写法①（§o.3）：VAR EXIST + handle (2,109)。
      -- 形态 = EXIST $!cand（!cand 自带前导 / ，插值后就是 /名）——带斜杠名字的本机
      -- 惯用法（62 处：tgautonum.pmlfnc:33-41、abauserview.pmlfrm:859-860 等）；旧形
      -- EXIST /$!... 会探成 //名（全库 0 例的未证实形态，R3 复核发现(13)后禁用，
      -- 契约 §o.3/§0.4-12）。(2,109) 双结局语义出处不变（abaarealib.pmlfrm:107-114）。
      !probeSet = FALSE
      var !probe EXIST $!cand
         handle (2,109)
            -- Undefined name => 可用（契约 §o.3 冻结语义；也覆盖畸形/未定义插值）
            !probeSet = TRUE
            !final = !cand
         endhandle
      if (!probeSet.eq(FALSE)) then
         -- VAR 正常返回：按值判定（assybuildname.pmlfnc:50,65 / abaarealib.pmlfrm:305 /
         -- abauserview.pmlfrm:860 / tgautonum.pmlfnc:39）
         if (!probe.upcase().eq('TRUEA')) then
            !final = ''
         else
            !final = !cand
         endif
      endif

      if (!final.length() gt 0) then
         -- 命中可用名（§o.2 步骤 3）
         if (!cand.eq(!base)) then
            -- 原名本身可用：不留改名记录（§o.7：renames 为空 = 全部原名可用）
         else
            !!pkpmjwdRenames.append(!t & '|' & !base & '|' & !cand)
         endif
         break
      endif
      !final = ''
   enddo

   -- 3) 命中 => 返回；100 个候选全部占用 => FAIL 留痕并返回空串（§o.2 步骤 4 / §o.6）
   if (!final.length() gt 0) then
      return !final
   endif
   !!pkpmjwdRenames.append('FAIL|' & !base & '|' & !base & 're99')
   return ''

endfunction
-- End of function !!pkpmjwdUniquename


-- ---------------------------------------------------------------------------
-- 记录条数（窗体显示"本次/累计"用；数组未建 => 0）
-- ---------------------------------------------------------------------------
define function !!pkpmjwdRenamesCount() is REAL

   if (undefined(!!pkpmjwdRenames)) then
      return 0
   endif
   return !!pkpmjwdRenames.size()

endfunction
-- End of function !!pkpmjwdRenamesCount


-- ---------------------------------------------------------------------------
-- FAIL 条数（'FAIL|' 开头的记录；数组未建 => 0）
-- ---------------------------------------------------------------------------
define function !!pkpmjwdRenamesFailCount() is REAL

   if (undefined(!!pkpmjwdRenames)) then
      return 0
   endif
   !n = 0
   do !i from 1 to !!pkpmjwdRenames.size()
      if (!!pkpmjwdRenames[!i].before('|').eq('FAIL')) then
         !n = !n + 1
      endif
   enddo
   return !n

endfunction
-- End of function !!pkpmjwdRenamesFailCount


-- ---------------------------------------------------------------------------
-- 逐条打印记录（窗体「改名清单」按钮用；输出到命令窗）
-- ---------------------------------------------------------------------------
define function !!pkpmjwdRenamesShow()

   if (undefined(!!pkpmjwdRenames)) then
      $P PKPM-JWD 改名记录：无（唯一化函数尚未运行过）
      return
   endif
   if (!!pkpmjwdRenames.size().eq(0)) then
      $P PKPM-JWD 改名记录：0 条（本次全部原名可用）
      return
   endif
   $P PKPM-JWD 改名记录（格式 TYPE|原名|实际名）：
   do !i from 1 to !!pkpmjwdRenames.size()
      $P PKPM-JWD 改名 $!i： $!!pkpmjwdRenames[$!i]
   enddo

endfunction
-- End of function !!pkpmjwdRenamesShow

-- End of file pkpmjwduniquename.pmlfnc
