------------------------------------------------------------------------------
-- PKPM2PDMS导入导出 —— PDMS 侧「导出数据库（目录/规格）」函数
-- 文件   : pkpm2pdmsdbexport.pmlfnc      落盘: GBK 无 BOM + CRLF，注释一律用 --
--
-- 入口   : !!pkpm2pdmsdbexport(!outFile is STRING) is STRING
--            缺省：自动遍历出根（全部 CATALOGUE + 全部 SPWLD），选项 TABULATE 0 ；
--            返回 'OK|file=…|bytes=…|roots=…|cata=…|spwl=…|sprf=…|spco=…|first=…'
--          !!pkpm2pdmsdbexportWith(!outFile is STRING, !itemsText is STRING, !options is STRING)
--            显式给根与选项（!itemsText = 空格分隔的元素全名；空则回退自动遍历）
--          !!pkpm2pdmsdbroots() is STRING            -- 遍历出根（全名，空格分隔）
--          !!pkpm2pdmsdbinventory() is STRING        -- 按类型计数（预检 / 与 dbparse 交叉核对）
--          !!pkpm2pdmsdbcounts(!container is DBREF)  -- 某容器的直接子元素按类型计数
--          !!pkpm2pdmsdbdate() is STRING             -- 头尾注释里的日期文本
--
-- 产物   : 与用户原件 `PKPM（PDMS数据库）.txt` 同格式的 DB Listing 文本
--          （`$S-` 头 → 核心写的 INPUT BEGIN … INPUT END/FINISH → `LABEL/handle/$S+/RETURN ERROR/endhandle` 尾），
--          供 Python 侧 engine/dbparse.py 解析（契约 v2 §l.5 的 12 条规则）。
--
-- == 为什么这里不逐元素手写这份文本（重要，不是偷懒）==
--   这份文本是 PDMS 核心 DATAL/DATALOG 引擎的产物，有 24 条文本级坑：
--   `$` 续行 + 纯值续行、类型全名/缩写混用、`OLD` 无 `END`、`END` 可省、
--   词值含空格且不加引号、`PPRO ( ATTRIB DESP[n] )` 表达式、`NARE`/`PSTR`/`GSTR`/`DTRE`/`CATR`
--   的“序号+宿主”引用、`LOCK` 零值属性、负数两种写法……（逐条带样本行号：
--   _recon/db_pdms_catalogue.md §5.3 坑清单 1..24）。
--   手写 PML 属性 dump 无法稳定复现它；PDMS 自己也不是手写的 —— `rptoutput.pmlfrm` 只是
--   「ALPHA FILE 打开输出文件 + 写头尾注释 + 核心 OUTPUT 命令出正文」的包装。
--   本函数照抄这一机制（每条都在本机 PDMS 安装内有出处）：
--     rptoutput.pmlfrm:707,737         OUTPUT $!options $!itemsText        ← 正文由核心写
--     rptoutput.pmlfrm:724-729         头部 6 行 WRITEALPHAFILE（逐字）
--     rptoutput.pmlfrm:3584-3596       footerComment() 尾部 9 行（逐字）
--     rptoutput.pmlfrm:744             调用方 comment = 'End Data Listing    Date : … '
--     实测（本次会话比对用户样本 L1/L70300）：WRITEALPHAFILE 会去掉行尾空格 ——
--     rptoutput 的字面量 `'$S-  -- Synonym translation OFF '`（尾空格）与样本实际字节
--     `$S-  -- Synonym translation OFF`（无尾空格）一致；本文件照抄字面量，产物同字节。
--     rptoutput.pmlfrm:2887            ALPHA FILE "$!文件" $!模式
--     rptoutput.pmlfrm:2302-2307,734-737   传给 OUTPUT 的是元素 fullName（不是 name）
--     rptoutput.pmlfrm:2862-2870       先 object FILE(...) 校验，再 ALPHA FILE
--     rptoutput.pmlfrm:691             !options = … & 'TABULATE' & !tabOpt
--     rptoutputopts.pmlfrm:144-163     AVEVA 默认选项：standard+udas+connections => 无 PASS/NOUDA/BRIEF，
--                                      TABULATE 用 ' 0 ' => 产物无缩进（与用户样本一致）
--     nucdesooutput.pmlobj:52-79       非窗体 PML 里 alpha file / writealphafile / output 的实际用法
--                                      （两遍式：output pass 1 = NEW…END，pass 2 = OLD…）
--     mds\common\functions\output.pmlfnc:32-36      OUTPUT 可在 define function 里执行
--     mds\design\objects\mdshealthchkdata.pmlobj:1193,1195          ALPHA FILE / ALPHA FILE END
--     pipefabricationmanager\design\objects\pfpipeconsistencycheck.pmlobj:113-120
--                                      全路径写法 + 事后 object FILE 读回
--   遍历用到的类型码与集合函数（全部有本机出处）：
--     common\functions\collectallfor.pmlfnc:35   define function !!collectAllFor(!types,!expr,!item) is ARRAY
--     common\functions\findspecworlds.pmlfnc:41  !!collectAllFor( |SPWL|, !with, WORLD )
--     common\functions\findspecs.pmlfnc:56       !!collectAllFor(|SPEC|, !with, !spwls[!index] )
--     admin\forms\admdbset.pmlfrm:224            !!collectAllFor('DB','',!!ce)   ← 表达式可空
--     common\functions\findfirstmember.pmlfnc:37,43,46  .mCount() / .members[i] / .type
--     paragon\objects\cgeocataupgrade.pmlobj:282 var !catas collect all CATA      ← 目录 = CATA
--     paragon\forms\catcreate.pmlfrm:138-179,187-235   elementTypes[]/longTypes[] 两表（Catalogue=CATA 等）
--     paragon\objects\catrefdata.pmlobj:263-292        同上（两份表一致）
--     paragon\objects\catdtseelement.pmlobj:140,148,590   DATA 类型码
--     paragon\objects\catgetelement.pmlobj:240,339        TEXT 类型码
--     paragon\objects\cgeocataupgrade.pmlobj:510          PLIN（PLINE 的缩写）
--     limbo\functions\clock.pmlfnc:31,34        define function !!clock() is CLOCK / object CLOCK()
--     common\objects\clock.pmlobj:23-38          CLOCK 的 .dom/.month/.year/.date/.time
--     common\functions\dbchangesinit.pmlfnc:50,60-73    函数里 !!clock() 及其成员的用法
--
-- 未实机验证（必须知道）：本文件只做过静态检查与逐条出处对照，**没有在 PDMS 里跑过**。
--   待实机确认：(1) `alpha file` / `output` 在 define function 里的可执行性；
--   (2) 产物行分隔符；(3) 在 Paragon 之外（Design）运行时 collectAllFor 的 dbType 范围。
--   替代路径（若上面任一条不成立）见同目录 README.txt「导出数据库（目录/规格）」一节。
------------------------------------------------------------------------------


--
-- == R6 拆分说明（2026-09-28）==
--   本机 PDMS 12.1 SP4 实测：.pmlfnc 只按「文件名（忽略大小写）= 函数名」被 PMLLIB
--   自动加载；多函数单文件里其余函数解析不到（"PML: Function not found"）。
--   故本文件只保留 !!pkpm2pdmsdbexport；其余 5 个函数已各自成文件：
--     pkpm2pdmsdbdate、pkpm2pdmsdbcounts、pkpm2pdmsdbroots、pkpm2pdmsdbinventory、pkpm2pdmsdbexportWith
--   拆分未改一行函数体；拆分前单体留档 验收/_R6_pml_split_backup/。
--   本文件所述的 ALPHA FILE / OUTPUT 路线仍**未实机验证**（见下表与 README 未验证项）。
--
-- ---------------------------------------------------------------------------
-- 缺省入口：自动遍历根 + 缺省选项
-- ---------------------------------------------------------------------------
define function !!pkpm2pdmsdbexport(!outFile is STRING) is STRING

   return !!pkpm2pdmsdbexportWith(!outFile, '', '')

endfunction
-- End of function !!pkpm2pdmsdbexport
