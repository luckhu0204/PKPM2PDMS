  NEW STSECTION /STSS_TUBE
  PURP STL

    NEW STCATEGORY /TUBE_TUBE
    PURP STL

      NEW TEXT /TUBE_TUBE-PA1
      PURP PARA
      STEX 'd(mm)'
      END
      NEW TEXT /TUBE_TUBE-PA2
      PURP PARA
      STEX 't(mm)'
      END
      NEW TEXT /TUBE_TUBE-PA3
      PURP PARA
      STEX 'A(cm2)'
      END
      NEW TEXT /TUBE_TUBE-PA4
      PURP PARA
      STEX 'I(cm4)'
      END
      NEW TEXT /TUBE_TUBE-PA5
      PURP PARA
      STEX 'i(cm)'
      END
      NEW TEXT /TUBE_TUBE-PA6
      PURP PARA
      STEX 'W(cm3)'
      END
      NEW TEXT /TUBE_TUBE-PA7
      PURP PARA
      STEX 'g(kg/m)'
      END

      NEW DTSET
        NEW DATA
        DKEY APAR
        PPRO ( ATTRIB PARA[1 ] )
        DPRO ( 0 )
        PURP PARA
        NUMB 1
        DTIT 'd(mm)'
        END
        NEW DATA
        DKEY BPAR
        PPRO ( ATTRIB PARA[2 ] )
        DPRO ( 0 )
        PURP PARA
        NUMB 2
        DTIT 't(mm)'
        END
        NEW DATA
        DKEY CPAR
        PPRO ( ATTRIB PARA[3 ] )
        DPRO ( 0 )
        PURP PARA
        NUMB 3
        DTIT 'A(cm2)'
        END
        NEW DATA
        DKEY DPAR
        PPRO ( ATTRIB PARA[4 ] )
        DPRO ( 0 )
        PURP PARA
        NUMB 4
        DTIT 'I(cm4)'
        END
        NEW DATA
        DKEY EPAR
        PPRO ( ATTRIB PARA[5 ] )
        DPRO ( 0 )
        PURP PARA
        NUMB 5
        DTIT 'i(cm)'
        END
        NEW DATA
        DKEY FPAR
        PPRO ( ATTRIB PARA[6 ] )
        DPRO ( 0 )
        PURP PARA
        NUMB 6
        DTIT 'W(cm3)'
        END
        NEW DATA
        DKEY GPAR
        PPRO ( ATTRIB PARA[7 ] )
        DPRO ( 0 )
        PURP PARA
        NUMB 7
        DTIT 'g(kg/m)'
        END
      END

      NEW PTSSET
        NEW PLINE
          PKEY NA
          PX 0
          PY 0
          DX 0
          DY 0
          CLFL true
          TUFL true
          PURP CLEW
          CCON ANY
        END
      END

