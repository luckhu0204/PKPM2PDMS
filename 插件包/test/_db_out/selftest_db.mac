      NEW DTSET
        NEW DATA
        DKEY APAR
        PPRO ( ATTRIB PARA[1 ] )
        DPRO ( 0 )
        PURP PARA
        NUMB 1
        DTIT 'd(mm)'
        END
        NEW DATA
        DKEY BPAR
