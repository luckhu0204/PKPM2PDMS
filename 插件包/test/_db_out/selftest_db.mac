        PPRO ( ATTRIB PARA[6 ] )
        DPRO ( 0 )
        PURP PARA
        NUMB 6
        DTIT 'Wx(cm3)'
        END
        NEW DATA
        DKEY GPAR
        PPRO ( ATTRIB PARA[7 ] )
        DPRO ( 0 )
        PURP PARA
        NUMB 7
        DTIT 'g(kg/m)'
        END
      END

      NEW PTSSET
