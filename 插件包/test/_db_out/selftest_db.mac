    NEW STCATEGORY /DOUBLE_L_UNEQUAL_SHORT
    PURP STL

      NEW TEXT /DOUBLE_L_UNEQUAL_SHORT-PA1
      PURP PARA
      STEX 'B(mm)'
      END
      NEW TEXT /DOUBLE_L_UNEQUAL_SHORT-PA2
      PURP PARA
      STEX 'b(mm)'
      END
      NEW TEXT /DOUBLE_L_UNEQUAL_SHORT-PA3
      PURP PARA
      STEX 't(mm)'
      END
      NEW TEXT /DOUBLE_L_UNEQUAL_SHORT-PA4
      PURP PARA
      STEX 'r(mm)'
      END
      NEW TEXT /DOUBLE_L_UNEQUAL_SHORT-PA5
      PURP PARA
      STEX 'x0(cm)'
      END
      NEW TEXT /DOUBLE_L_UNEQUAL_SHORT-PA6
      PURP PARA
      STEX 'y0(cm)'
      END

      NEW DTSET
        NEW DATA
        DKEY APAR
        PPRO ( ATTRIB PARA[1 ] )
        DPRO ( 0 )
        PURP PARA
        NUMB 1
        DTIT 'B(mm)'
        END
        NEW DATA
        DKEY BPAR
        PPRO ( ATTRIB PARA[2 ] )
        DPRO ( 0 )
        PURP PARA
        NUMB 2
        DTIT 'b(mm)'
        END
        NEW DATA
        DKEY CPAR
        PPRO ( ATTRIB PARA[3 ] )
        DPRO ( 0 )
        PURP PARA
        NUMB 3
        DTIT 't(mm)'
        END
        NEW DATA
        DKEY DPAR
        PPRO ( ATTRIB PARA[4 ] )
        DPRO ( 0 )
        PURP PARA
        NUMB 4
        DTIT 'r(mm)'
        END
        NEW DATA
        DKEY EPAR
        PPRO ( ATTRIB PARA[5 ] )
        DPRO ( 0 )
        PURP PARA
        NUMB 5
        DTIT 'x0(cm)'
        END
        NEW DATA
        DKEY FPAR
        PPRO ( ATTRIB PARA[6 ] )
        DPRO ( 0 )
        PURP PARA
        NUMB 6
        DTIT 'y0(cm)'
        END
      END

      NEW PTSSET
        NEW PLINE
          PKEY NA
          PX 0
          PY 0
          DX 0
          DY 0
          CLFL true
          TUFL true
          PURP CLEW
          CCON ANY
        END
      END

